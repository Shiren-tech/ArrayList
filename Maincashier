import java.util.ArrayList;
import java.util.Scanner;

class Casier {
    String item;
    int price, qty;

    public Casier(String a, int b, int c) {
        this.item = a;
        this.price = b;
        this.qty = c;
    }

    public int getSubtotal() {
        return price * qty;
    }
}

public class MainCasier {
    public static void main(String[] args) {
        ArrayList<Casier> product = new ArrayList<>();
        Scanner input = new Scanner(System.in);

        product.add(new Casier("Bags", 100000, 2));
        product.add(new Casier("Hat", 20000, 2));

        String repeat;

        do {
            System.out.print("Name product: ");
            String item = input.nextLine();

            System.out.print("Price: ");
            int price = input.nextInt();

            System.out.print("Quantity: ");
            int qty = input.nextInt();
            input.nextLine();

            product.add(new Casier(item, price, qty));

            System.out.print("Add new data? (yes/no): ");
            repeat = input.nextLine();

        } while (repeat.equalsIgnoreCase("yes"));

        System.out.println("\nNo\tItem\tPrice\tQty\tSubtotal");
        System.out.println("=========================================");

        int total = 0;
        for (int i = 0; i < product.size(); i++) {
            Casier p = product.get(i);
            System.out.println((i + 1) + ".\t" + p.item + "\t" + p.price + "\t" + p.qty + "\t" + p.getSubtotal());
            total += p.getSubtotal();
        }

        System.out.println("=========================================");
        System.out.println("Total: " + total);

        input.close();
    }
}
